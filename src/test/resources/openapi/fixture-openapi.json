{
  "openapi": "3.0.1",
  "info": {
    "title": "Fixture API",
    "description": "Small OpenAPI document exercising the parser/schema/director paths in tests.",
    "version": "1.0.0"
  },
  "paths": {
    "/task/{id}": {
      "get": {
        "operationId": "getTask",
        "summary": "Get a task",
        "description": "Returns one task by id.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "maxResults", "in": "query", "schema": { "type": "integer", "default": 50 } },
          { "name": "X-Tenant", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/task": {
      "post": {
        "operationId": "createTask",
        "summary": "Create a task",
        "description": "Creates a task; the query parameter 'name' collides with the body property 'name'.",
        "parameters": [
          { "name": "name", "in": "query", "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "assignee": { "type": "string" }
                },
                "required": ["name"]
              }
            }
          }
        },
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/task/update": {
      "post": {
        "operationId": "updateTask",
        "summary": "Update a task",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TaskDto" }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/deployment/create": {
      "post": {
        "operationId": "createDeployment",
        "summary": "Create a deployment",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "deployment-name": { "type": "string" },
                  "data": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/task/patch": {
      "post": {
        "operationId": "patchTask",
        "summary": "Patch a task",
        "description": "Body composed with allOf; both subschemas must merge into one flat body.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "type": "object", "properties": { "a": { "type": "string" } } },
                  { "type": "object", "properties": { "b": { "type": "integer" } }, "required": ["b"] }
                ]
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/task/search": {
      "post": {
        "operationId": "searchTasks",
        "summary": "Search tasks",
        "description": "Body with $refs nested inside additionalProperties, anyOf and items.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "byPriority": { "additionalProperties": { "$ref": "#/components/schemas/Priority" } },
                  "anyPriority": { "anyOf": [ { "$ref": "#/components/schemas/Priority" } ] },
                  "priorities": { "type": "array", "items": { "$ref": "#/components/schemas/Priority" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/misc/anonymous": {
      "get": {
        "summary": "Operation without operationId — must not become a tool",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "TaskDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "priority": { "$ref": "#/components/schemas/Priority" }
        }
      },
      "Priority": {
        "type": "string",
        "enum": ["LOW", "MEDIUM", "HIGH"]
      }
    }
  }
}
